# Copier en .env (jamais commité). Valeurs de développement uniquement.

# Base SQLite locale (prototype). Passer à PostgreSQL = changer cette URL.
DATABASE_URL=sqlite:///./.storage/collecte.db

# Stockage local des fichiers déposés
STORAGE_DIR=./.storage/files

JWT_SECRET=change-me-with-a-long-random-string
JWT_ACCESS_TTL_MINUTES=60

# OCR
TESSERACT_CMD=tesseract
OCR_LANGS=fra+eng

# Modèle ML : dossier de l'artefact produit par src/ml
ML_MODEL_PATH=src/ml/artifacts/current
# Sous ce seuil de confiance, le document part en revue par le consultant
CLASSIFICATION_MIN_CONFIDENCE=0.80

# Relances : e-mail réel si SMTP_HOST est renseigné, sinon écriture dans le journal (démo)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@collecte.local
REMINDER_INTERVAL_HOURS=24

# Inscription consultant : desactivee si vide
CONSULTANT_INVITE_CODE=
# Pieces attendues par dossier (liste hypothetique, a valider)
REQUIRED_DOCUMENT_TYPES=facture,fiche_de_paie,contrat,compte_rendu_rd

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
